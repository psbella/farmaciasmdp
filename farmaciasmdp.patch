+      <a href="/" class="btn-volver-app">← Volver a la aplicación</a>
+    </div>
+
+    <footer class="footer">
+      <p><span class="code-symbol">&lt;/&gt;</span> Desarrollado por <a href="mailto:pablo.s.bella@gmail.com?subject=Web%20Farmacias">Pablo Bella</a> con 💚</p>
+      <p>
